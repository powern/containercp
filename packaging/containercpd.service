[Unit]
Description=ContainerCP Daemon — Container-native hosting control panel
Documentation=https://github.com/powern/containercp
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/containercpd
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Security hardening
# ProtectSystem=yes would make /etc read-only, which prevents groupadd/useradd
# from writing to /etc/passwd, /etc/group, /etc/shadow, /etc/gshadow.
# The daemon is a system administration tool and must write these files
# for SFTP user provisioning. NoNewPrivileges and PrivateTmp remain active.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=no
ReadWritePaths=/etc/ssh/sshd_config.d /srv/containercp

[Install]
WantedBy=multi-user.target
