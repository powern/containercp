[Unit]
Description=ContainerCP Daemon — Container-native hosting control panel
Documentation=https://github.com/powern/containercp
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/containercpd
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

# Security hardening — system account databases must be writable for SFTP provisioning
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/etc/passwd /etc/group /etc/shadow /etc/gshadow /etc/ssh/sshd_config.d /srv/containercp

[Install]
WantedBy=multi-user.target
